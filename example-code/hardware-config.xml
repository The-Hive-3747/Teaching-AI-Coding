<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Robot Controller configuration for The Hive's robot-in-one-week robot, RECONSTRUCTED
  from the device names and ports in the TeamCode source. Motor ports and motor types
  are placeholders (the code doesn't say); servo ports are the ones the code comments give.

  The device NAMES are what matter: they must match the strings in hardwareMap.get(...) exactly.
  The real config lives on the Control Hub (Driver Hub -> Configure Robot). Ben: swap this for
  the exported XML from the Control Hub when convenient.
-->
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <!-- motor ports: placeholders -->
            <goBILDA5202SeriesMotor name="front_left_drive"  port="0" />
            <goBILDA5202SeriesMotor name="front_right_drive" port="1" />
            <goBILDA5202SeriesMotor name="back_left_drive"   port="2" />
            <goBILDA5202SeriesMotor name="back_right_drive"  port="3" />
            <!-- servo ports: from the source comments -->
            <ContinuousRotationServo name="intake_servo_left" port="1" />
            <Servo                   name="led_left"          port="3" />
            <ContinuousRotationServo name="firewheel_left"    port="5" />  <!-- transfer mechanism, removed mid-week -->
        </LynxModule>
        <LynxModule name="Expansion Hub 2" port="2">
            <!-- motor ports: placeholders -->
            <goBILDA5202SeriesMotor name="flywheel" port="0" />
            <goBILDA5202SeriesMotor name="intake"   port="1" />
            <!-- servo ports: from the source comments -->
            <ContinuousRotationServo name="firewheel_right"    port="1" />  <!-- transfer mechanism, removed mid-week -->
            <Servo                   name="led_right"          port="3" />
            <ContinuousRotationServo name="intake_servo_right" port="5" />
        </LynxModule>
    </LynxUsbDevice>
</Robot>
